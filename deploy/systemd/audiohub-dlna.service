[Unit]
Description=AudioHub DLNA renderer
After=audiohub-engine.service network-online.target
Requires=audiohub-engine.service
PartOf=audiohub-engine.service
[Service]
User=audiohub
Group=audiohub
SupplementaryGroups=audio
WorkingDirectory=/opt/homelab-audiohub
Environment=HOME=/var/lib/audiohub
Environment=XDG_RUNTIME_DIR=/run/audiohub
Environment=PULSE_SERVER=unix:/run/audiohub/pulse/native
ExecStartPre=/bin/sh -c 'pactl list short sinks | grep -q audiohub_dlna || pactl load-module module-null-sink sink_name=audiohub_dlna rate=48000 channels=2 sink_properties=device.description=AudioHub-DLNA'
ExecStart=/usr/bin/gmediarender -I enx00e04c398dc8 -p 49494 -f "Homelab Audio" -u bb2cb217-ed00-4e8b-9a63-0e8b14a7cdc6 --gstout-audiosink=pulsesink --gstout-audiodevice=audiohub_dlna --gstout-buffer-duration=2 --logfile=stdout
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077
MemoryMax=512M
TasksMax=128
[Install]
WantedBy=multi-user.target
